# Temporal Connection
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hospital-ai-queue

# Google Gemini Settings
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.0-flash

# OpenAI-Compatible API Settings (e.g. Baseten, DeepSeek, etc.)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
OPENAI_BASE_URL=https://inference.baseten.co/v1

USE_LLM=true

# AAVA Agent Platform Settings
AAVA_BASE_URL=https://int-ai.aava.ai
AAVA_API_KEY=your-aava-api-key-here
AAVA_BRIEFING_AGENT_ID=56091
AAVA_POLL_INTERVAL_SECONDS=2
AAVA_POLL_TIMEOUT_SECONDS=60
