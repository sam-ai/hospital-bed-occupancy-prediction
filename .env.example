# Temporal Connection
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hospital-ai-queue

# Google Gemini Settings
GOOGLE_API_KEY=your-google-api-key-here
